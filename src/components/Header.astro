---
import Logo from './Logo.astro';
import { nav } from '../data/nav';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="sticky top-0 z-40 bg-bez/90 backdrop-blur-md">
  <div class="kontener flex h-18 items-center justify-between gap-6">
    <a href="/" class="h-11 shrink-0 text-zielen" aria-label="Kościół Pełnia - strona główna">
      <Logo class="h-11" />
    </a>

    <nav aria-label="Główna" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="rounded-full px-4 py-2 text-[0.95rem] font-medium transition-colors hover:bg-zielen/10 aria-[current=page]:bg-zielen aria-[current=page]:text-bez"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <details class="group lg:hidden" id="menu">
      <summary
        class="flex cursor-pointer list-none items-center gap-2 rounded-full bg-zielen px-4 py-2 font-medium text-bez [&::-webkit-details-marker]:hidden"
      >
        <span class="group-open:hidden">Menu</span>
        <span class="hidden group-open:inline">Zamknij</span>
      </summary>
      <nav
        aria-label="Główna (mobile)"
        class="absolute inset-x-0 top-18 border-t border-zielen/15 bg-bez px-4 pt-4 pb-8 shadow-[0_20px_30px_-20px_rgb(45_35_27/0.35)]"
      >
        <ul class="flex flex-col gap-1">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class="font-naglowek block rounded-2xl px-4 py-3.5 text-lg aria-[current=page]:bg-zielen aria-[current=page]:text-bez"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  // Close the mobile menu on Escape and when a link inside it is followed.
  const menu = document.getElementById('menu') as HTMLDetailsElement | null;
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.open) menu.open = false;
  });
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) menu.open = false;
  });
</script>
