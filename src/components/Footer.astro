---
import Logo from './Logo.astro';
import { nav } from '../data/nav';
import { site } from '../data/site';

const s = site.sunday;
---

<footer class="mt-24 bg-zielen text-bez">
  <div class="kontener grid gap-12 py-16 md:grid-cols-[auto_1fr_1fr_1fr]">
    <Logo class="h-24 text-bez" />

    <div>
      <h2 class="font-naglowek mb-4 text-sm text-bursztyn">Niedziela</h2>
      <p class="leading-relaxed">
        Nabożeństwo o {s.start}<br />
        {s.venueName && <>{s.venueName}<br /></>}
        ul. {s.street}<br />
        {s.postalCode} {s.city}
      </p>
      <a href={s.mapsUrl} class="mt-3 inline-block underline underline-offset-4" rel="noopener" target="_blank">
        Otwórz w mapach
      </a>
    </div>

    <div>
      <h2 class="font-naglowek mb-4 text-sm text-bursztyn">Kontakt</h2>
      <ul class="space-y-2">
        <li><a href={`mailto:${site.email}`} class="underline underline-offset-4">{site.email}</a></li>
        <li><a href={site.instagram} rel="noopener" target="_blank" class="underline underline-offset-4">Instagram</a></li>
        <li><a href={site.facebook} rel="noopener" target="_blank" class="underline underline-offset-4">Facebook</a></li>
      </ul>
    </div>

    <nav aria-label="Stopka">
      <h2 class="font-naglowek mb-4 text-sm text-bursztyn">Strona</h2>
      <ul class="space-y-2">
        {nav.map((item) => <li><a href={item.href} class="hover:underline">{item.label}</a></li>)}
        <li><a href="/polityka-prywatnosci" class="hover:underline">Polityka prywatności</a></li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-bez/15">
    <p class="kontener py-6 text-sm text-bez/75">
      {site.legalName} jest częścią Kościoła Zielonoświątkowego w RP.
    </p>
  </div>
</footer>
