---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

// Our own wording of the eight points of the KZ confession (https://kz.pl/wyznanie-wiary/),
// with references taken from the KZ commentary.
const creed = [
  {
    title: 'Biblia',
    text: 'Pismo Święte jest natchnionym Słowem Bożym. To ono, a nie tradycja czy ludzkie autorytety, jest dla nas miarą wiary i życia.',
    refs: '2 Tm 3,15-17; 2 P 1,19-21',
  },
  {
    title: 'Bóg w Trójcy',
    text: 'Jest jeden Bóg, Stwórca wszystkiego, który objawia się jako Ojciec, Syn i Duch Święty.',
    refs: 'Pwt 6,4; Mt 28,19; 2 Kor 13,13',
  },
  {
    title: 'Jezus Chrystus',
    text: 'Jezus jest Synem Bożym, który stał się człowiekiem. Umarł na krzyżu za nasze grzechy, zmartwychwstał w ciele, wstąpił do nieba i powróci. Jest jedynym pośrednikiem między Bogiem a ludźmi.',
    refs: 'J 1,14; Flp 2,5-11; 1 Tm 2,5',
  },
  {
    title: 'Zbawienie z łaski',
    text: 'Nie zasłużymy na Boże przebaczenie dobrymi uczynkami. Otrzymujemy je za darmo, gdy odwracamy się od grzechu i ufamy Jezusowi. Dobre uczynki są owocem tej nowej relacji, a nie jej ceną.',
    refs: 'Rz 3,23-24; Ef 2,8-10',
  },
  {
    title: 'Duch Święty i Jego dary',
    text: 'Duch Święty mieszka w każdym wierzącym. Wierzymy w chrzest Duchem Świętym, który daje moc do życia i służby, oraz w dary Ducha, także mówienie językami i proroctwo.',
    refs: 'Dz 1,8; Dz 2,4; 1 Kor 12',
  },
  {
    title: 'Kościół',
    text: 'Kościół to wszyscy, którzy narodzili się na nowo, a jego Głową jest Chrystus. Lokalny zbór to rodzina, w której razem wzrastamy, służymy i świadczymy o Jezusie.',
    refs: 'Mt 16,18; Ef 4,1-16; Kol 1,18',
  },
  {
    title: 'Uzdrowienie',
    text: 'Bóg uzdrawia także dziś. Modlimy się o chorych z wiarą, a jednocześnie z wdzięcznością korzystamy z pomocy lekarzy.',
    refs: 'Jk 5,13-16; Mk 16,17-18',
  },
  {
    title: 'Powrót Jezusa i życie wieczne',
    text: 'Jezus powróci, aby sądzić świat. Czeka nas zmartwychwstanie i życie wieczne z Bogiem w nowym niebie i na nowej ziemi.',
    refs: '1 Tes 4,13-18; 1 Kor 15; Ap 21',
  },
];

const practice = [
  {
    title: 'Chrzest w wodzie',
    text: 'Chrzcimy osoby, które świadomie uwierzyły w Jezusa i chcą za Nim iść, przez całkowite zanurzenie w wodzie. To publiczne wyznanie wiary i znak nowego życia.',
    refs: 'Rz 6,3-4',
  },
  {
    title: 'Wieczerza Pańska',
    text: 'Raz w miesiącu łamiemy chleb i pijemy z kielicha na pamiątkę śmierci Jezusa, tak jak On nam polecił. Wierzymy, że Chrystus jest w niej obecny duchowo, a nie materialnie.',
    refs: '1 Kor 11,23-26',
  },
  {
    title: 'Chrzest Duchem Świętym',
    text: 'Wierzymy, że Bóg chce napełnić swoim Duchem każdego wierzącego, jak w dniu Pięćdziesiątnicy. Często towarzyszy temu mówienie innymi językami. To dar, który daje odwagę i moc na co dzień, a nie odznaka lepszych chrześcijan.',
    refs: 'Dz 2,1-4',
  },
  {
    title: 'Modlitwa i dary Ducha',
    text: 'Na nabożeństwach jest miejsce na modlitwę o uzdrowienie, proroctwo i inne dary Ducha. Dbamy o to, żeby wszystko odbywało się „godnie i w porządku”.',
    refs: '1 Kor 12-14',
  },
];

const history = [
  { year: '1906', title: 'Azusa Street', text: 'Przebudzenie w Los Angeles, symboliczny początek ruchu zielonoświątkowego na świecie.' },
  { year: '1910', title: 'Śląsk Cieszyński', text: 'Powstają pierwsze zbory zielonoświątkowe w Polsce.' },
  { year: '1987', title: 'Kościół Zielonoświątkowy w RP', text: 'Polskie zbory zielonoświątkowe tworzą Kościół w obecnej formie.' },
  { year: 'Dziś', title: 'Pełnia w Wieliczce', text: 'Nowy zbór KZ, który buduje społeczność w mieście soli.' },
];
---

<Base
  title="W co wierzymy"
  description="Jesteśmy kościołem protestanckim, zielonoświątkowym. Wierzymy w Biblię, zbawienie z łaski przez wiarę w Jezusa i moc Ducha Świętego dziś."
>
  <PageHero
    eyebrow="W co wierzymy"
    title="Chrześcijanie. Protestanci. Zielonoświątkowcy."
    lead="Wierzymy w to samo, co chrześcijanie od dwóch tysięcy lat wyznają w Składzie Apostolskim. Poniżej wyjaśniamy, co znaczy dla nas każde z tych trzech słów."
  />

  <section class="kontener grid gap-4 pb-16 lg:grid-cols-3">
    <div class="@container rounded-(--radius-karta) bg-zielen p-8 text-bez">
      <h2 class="font-naglowek text-[min(1.25rem,calc(100cqw/16))] text-bursztyn">Chrześcijanie</h2>
      <p class="mt-4 leading-relaxed text-pretty">
        W centrum naszej wiary jest Jezus Chrystus: Jego życie, śmierć i zmartwychwstanie. Z całym Kościołem wyznajemy
        Skład Apostolski i Credo nicejsko-konstantynopolitańskie.
      </p>
    </div>
    <div class="@container rounded-(--radius-karta) bg-bursztyn p-8 text-braz">
      <h2 class="font-naglowek text-[min(1.25rem,calc(100cqw/16))]">Protestanci</h2>
      <p class="mt-4 leading-relaxed text-pretty">
        Wyrastamy z reformacji XVI wieku. Najwyższym autorytetem jest dla nas Biblia, a zbawienie przyjmujemy z łaski,
        przez wiarę w Chrystusa, a nie dzięki własnym zasługom.
      </p>
    </div>
    <div class="@container rounded-(--radius-karta) bg-pomarancz p-8 text-braz">
      <h2 class="font-naglowek text-[min(1.25rem,calc(100cqw/16))]">Zielonoświątkowcy</h2>
      <p class="mt-4 leading-relaxed text-pretty">
        Nazwa pochodzi od Zielonych Świąt, czyli Pięćdziesiątnicy z Dziejów Apostolskich 2. Wierzymy, że Duch Święty
        działa dziś z tą samą mocą: zmienia ludzi, uzdrawia i obdarza duchowymi darami.
      </p>
    </div>
  </section>

  <section class="kontener py-16" aria-labelledby="wyznanie">
    <h2 id="wyznanie" class="font-naglowek text-3xl md:text-4xl">Nasze wyznanie wiary</h2>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-pretty">
      Jako zbór Kościoła Zielonoświątkowego w RP dzielimy jego wyznanie wiary. Poniżej streszczamy je naszymi słowami.
      Pełny, oficjalny tekst znajdziesz na{' '}
      <a href="https://kz.pl/wyznanie-wiary/" rel="noopener" class="font-semibold underline decoration-pomarancz underline-offset-4">kz.pl</a>.
    </p>
    <ol class="mt-12 grid gap-4 md:grid-cols-2">
      {
        creed.map((item, i) => (
          <li class="flex gap-5 rounded-(--radius-karta) bg-bez-jasny p-7 ring-1 ring-zielen/15">
            <span class="font-akcent w-9 shrink-0 text-4xl text-pomarancz">{i + 1}</span>
            <div>
              <h3 class="text-xl font-bold">{item.title}</h3>
              <p class="mt-2 leading-relaxed text-pretty">{item.text}</p>
              <p class="mt-3 text-sm opacity-70">{item.refs}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="praktyka" class="px-2 py-10 sm:px-4">
    <div class="mx-auto max-w-[80rem] rounded-(--radius-duzy) bg-zielen text-bez">
      <div class="kontener py-14 md:py-20">
        <h2 id="praktyka" class="font-naglowek text-3xl md:text-4xl">Jak to wygląda w praktyce</h2>
        <ul class="mt-10 grid gap-4 md:grid-cols-2">
          {
            practice.map((item) => (
              <li class="flex flex-col rounded-(--radius-karta) bg-bez/[0.07] p-7 ring-1 ring-bez/15 md:p-8">
                <h3 class="text-xl font-bold text-bursztyn">{item.title}</h3>
                <p class="mt-3 flex-1 leading-relaxed text-pretty text-bez/90">{item.text}</p>
                <p class="mt-5 self-start rounded-full bg-bez/10 px-3 py-1 text-sm font-medium text-bez/80">{item.refs}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="kontener py-16 md:py-24" aria-labelledby="historia">
    <h2 id="historia" class="font-naglowek text-3xl md:text-4xl">Skąd się wzięliśmy</h2>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-pretty">
      Ruch zielonoświątkowy to dziś jeden z najszybciej rosnących nurtów chrześcijaństwa na świecie. Nasza historia w
      czterech krokach:
    </p>
    <ol class="mt-12 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        history.map((step, i) => (
          <li class:list={['relative border-t-[3px] pt-6', i === history.length - 1 ? 'border-pomarancz' : 'border-zielen/25']}>
            <span
              aria-hidden="true"
              class:list={['absolute -top-[9px] left-0 size-[15px] rounded-full', i === history.length - 1 ? 'bg-pomarancz' : 'bg-zielen']}
            />
            <p class:list={['font-akcent text-5xl', i === history.length - 1 ? 'text-pomarancz' : '']}>{step.year}</p>
            <h3 class="mt-3 text-lg font-bold">{step.title}</h3>
            <p class="mt-2 leading-relaxed text-pretty">{step.text}</p>
          </li>
        ))
      }
    </ol>
    <dl class="mt-14 grid gap-4 sm:grid-cols-2">
      <div class="flex flex-col rounded-(--radius-karta) bg-bursztyn p-7 text-braz">
        <dt class="font-semibold">zborów Kościoła Zielonoświątkowego w Polsce</dt>
        <dd class="font-akcent order-first text-6xl">200+</dd>
      </div>
      <div class="flex flex-col rounded-(--radius-karta) bg-bez-jasny p-7 ring-1 ring-zielen/15">
        <dt class="font-semibold">wiernych w całym kraju</dt>
        <dd class="font-akcent order-first text-6xl">~24 tys.</dd>
      </div>
    </dl>
    <p class="mt-6 text-sm opacity-75">
      KZ należy do Aliansu Ewangelicznego w RP, Pentecostal European Fellowship i World Assemblies of God Fellowship.
    </p>
  </section>

  <section class="kontener py-16">
    <div class="rounded-(--radius-duzy) bg-zielen p-8 text-bez md:p-12">
      <p class="max-w-2xl text-xl leading-relaxed text-pretty">
        Masz pytania o wiarę? Chętnie o nich porozmawiamy przy kawie po nabożeństwie albo napisz do nas. Nie musisz
        wszystkiego rozumieć ani się z nami zgadzać, żeby przyjść.
      </p>
      <a href="/niedziela" class="mt-6 inline-block rounded-full bg-bez px-6 py-3.5 font-semibold text-zielen">Przyjdź w niedzielę</a>
    </div>
  </section>
</Base>
