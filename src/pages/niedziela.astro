---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Brak from '../components/Brak.astro';
import Kids from '../components/Kids.astro';
import { getSite } from '../lib/settings';

const site = await getSite();

const s = site.sunday;

const service = [
  {
    title: 'Uwielbienie',
    text: 'Śpiewamy współczesne pieśni, wiele z nich w naszych własnych tłumaczeniach. Teksty są na ekranie. Możesz śpiewać, słuchać albo po prostu być.',
  },
  {
    title: 'Słowo Boże',
    text: 'Kazanie, które łączy Biblię z codziennym życiem. Trwa zwykle 30-40 minut. W tym czasie dzieci od 3 lat idą na swoje zajęcia.',
  },
  {
    title: 'Modlitwa',
    text: 'Jako kościół zielonoświątkowy zostawiamy miejsce na modlitwę i działanie Ducha Świętego. Jeśli coś będzie dla Ciebie nowe, śmiało zapytaj nas po nabożeństwie.',
  },
  {
    title: 'Wieczerza Pańska',
    note: 'raz w miesiącu',
    text: 'Razem łamiemy chleb i pijemy z kielicha na pamiątkę śmierci i zmartwychwstania Jezusa.',
  },
];

const faq = [
  {
    q: 'W co się ubrać?',
    a: 'W cokolwiek, w czym czujesz się dobrze. U nas są i dżinsy, i marynarki, nikt nie zwraca na to uwagi.',
  },
  {
    q: 'Czy muszę coś umieć albo wiedzieć?',
    a: 'Nie. Nie musisz znać pieśni, modlitw ani Biblii. Możesz po prostu przyjść, posłuchać i zobaczyć, jak to wygląda.',
  },
  {
    q: 'Czy będę musiał(a) coś mówić albo się przedstawiać?',
    a: 'Nie. Chętnie Cię poznamy przy kawie, ale nikt nie wywoła Cię na środek.',
  },
  {
    q: 'Co z dziećmi?',
    a: 'Każde dziecko jest mile widziane. Maluchy do 3 lat mają kącik zabaw na sali, a dzieci od 3 lat na czas kazania idą na swoje zajęcia z opiekunami.',
  },
  {
    q: 'Czy trzeba coś wrzucać na tacę?',
    a: 'Nie. Ofiara jest dobrowolna i przeznaczona dla osób, które uważają ten kościół za swój dom. Jesteś naszym gościem.',
  },
  {
    q: 'Jak długo to trwa?',
    a: 'Samo nabożeństwo trwa około godziny. Wiele osób zostaje potem na kawie i rozmowach.',
  },
];
---

<Base
  title="Twoja pierwsza niedziela"
  description={`Nabożeństwa w każdą niedzielę o ${s.start}, ul. ${s.street}, ${s.city}. Zobacz, czego się spodziewać.`}
>
  <PageHero
    eyebrow="Twoja pierwsza niedziela"
    title="Tu jesteś w pełni mile widziany"
    lead="Nie wiesz, czego się spodziewać? Spokojnie. Poniżej znajdziesz wszystko, co warto wiedzieć przed pierwszą wizytą."
  >
    <Fragment slot="title">Tu jesteś <span class="text-pomarancz">w pełni</span> mile widziany</Fragment>
  </PageHero>

  <section class="kontener grid gap-4 pb-16 md:grid-cols-[1.2fr_1fr]">
    <div class="rounded-(--radius-duzy) bg-zielen p-8 text-bez md:p-12">
      <h2 class="font-naglowek text-sm text-bursztyn">Kiedy</h2>
      <p class="font-akcent mt-3 text-[clamp(4rem,12vw,7rem)]">{s.start}</p>
      <p class="mt-2 text-xl font-medium">w każdą niedzielę</p>
    </div>
    <div class="flex flex-col justify-between rounded-(--radius-duzy) bg-bursztyn p-8 text-braz md:p-12">
      <div>
        <h2 class="font-naglowek text-sm">Gdzie</h2>
        <p class="mt-4 text-2xl leading-snug font-bold">
          {s.venueName ? s.venueName : <Brak co="nazwa miejsca / sali" />}<br />
          ul. {s.street}<br />
          {s.postalCode} {s.city}
        </p>
        <p class="mt-4 leading-relaxed">
          {s.parking ?? <Brak co="jak dojechać i gdzie zaparkować" />}
        </p>
      </div>
      <a
        href={s.mapsUrl}
        target="_blank"
        rel="noopener"
        class="mt-8 self-start rounded-full bg-braz px-6 py-3.5 font-semibold text-bez transition hover:bg-zielen"
      >
        Otwórz w Google Maps
      </a>
    </div>
  </section>

  <Kids kids={s.kids} />

  <section class="kontener py-16" aria-labelledby="przebieg">
    <h2 id="przebieg" class="font-naglowek mb-10 text-3xl md:text-4xl">Jak wygląda niedziela</h2>
    <ol class="relative grid gap-4 md:grid-cols-3">
      {
        s.timeline.map((step) => (
          <li class="rounded-(--radius-karta) bg-bez-jasny p-7 ring-1 ring-zielen/15">
            <p class="font-akcent text-4xl text-pomarancz">{step.time}</p>
            <h3 class="mt-4 text-xl font-bold">{step.title}</h3>
            <p class="mt-2 leading-relaxed text-pretty">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="kontener grid gap-10 py-16 md:py-24 lg:grid-cols-[1fr_1.4fr] lg:gap-16" aria-labelledby="nabozenstwo">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <h2 id="nabozenstwo" class="font-naglowek text-3xl md:text-4xl">Co dzieje się podczas nabożeństwa</h2>
      <p class="mt-5 max-w-md text-lg leading-relaxed text-pretty">
        Nabożeństwo trwa około godziny. Nie musisz niczego znać ani umieć. Możesz po prostu przyjść i zobaczyć.
      </p>
    </div>
    <ol class="divide-y divide-zielen/15 border-y border-zielen/15">
      {
        service.map((step, i) => (
          <li class="grid grid-cols-[3.5rem_1fr] gap-x-4 py-7 sm:grid-cols-[4.5rem_1fr]">
            <span class="font-akcent text-5xl text-pomarancz sm:text-6xl">{i + 1}</span>
            <div>
              <h3 class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xl font-bold md:text-2xl">
                {step.title}
                {step.note && (
                  <span class="rounded-full bg-bursztyn px-3 py-0.5 text-sm font-semibold text-braz">{step.note}</span>
                )}
              </h3>
              <p class="mt-2 text-lg leading-relaxed text-pretty">{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="kontener py-16 md:py-24" aria-labelledby="pytania">
    <h2 id="pytania" class="font-naglowek mb-10 text-center text-3xl md:text-4xl">Częste pytania</h2>
    <div class="mx-auto max-w-3xl divide-y divide-zielen/15 border-y border-zielen/15">
      {
        faq.map((item) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-bold [&::-webkit-details-marker]:hidden">
              {item.q}
              <span aria-hidden="true" class="text-2xl text-pomarancz transition group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 max-w-2xl leading-relaxed text-pretty">{item.a}</p>
          </details>
        ))
      }
    </div>
    <p class="mt-10 text-center text-lg">
      Masz inne pytanie? Napisz: <a href={`mailto:${site.email}`} class="font-semibold underline decoration-pomarancz underline-offset-4">{site.email}</a>
    </p>
  </section>
</Base>
